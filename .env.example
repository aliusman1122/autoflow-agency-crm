# AutoFlow Agency CRM — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ==================================================
# Supabase (Required)
# ==================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==================================================
# Encryption (Required for Groq key storage)
# Must be at least 32 characters long.
# Generate with: openssl rand -base64 32
# ==================================================
ENCRYPTION_SECRET=your-super-secret-encryption-key-min-32-chars

# ==================================================
# Groq API (Optional server-side fallback)
# If set, these are used when no per-user key is stored.
# Users can also add their own key via Settings → Integrations.
# GROQ_API_KEY  — server-only (Route Handlers, Server Actions)
# NEXT_PUBLIC_GROQ_API_KEY — also exposed to the browser (less secure)
# ==================================================
# GROQ_API_KEY=your-groq-api-key
# NEXT_PUBLIC_GROQ_API_KEY=your-groq-api-key

# ==================================================
# Webhooks
# ==================================================
N8N_WEBHOOK_SECRET=your-secret-key-here
